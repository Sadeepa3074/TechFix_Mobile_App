<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#09090B"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="56dp"
        android:paddingBottom="24dp">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/btnBackDetail"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="#161618"
                android:gravity="center"
                android:text="←"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Manage Repair"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <View
                android:layout_width="36dp"
                android:layout_height="36dp"/>
        </LinearLayout>

        <!-- Booking Summary Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#161618"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#2A2A2A"
            app:strokeWidth="1dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvDetailRepairId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TF-0003"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvDetailDevice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Desktop"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvDetailCustomer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Customer: John Doe"
                    android:textColor="#BB86FC"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvDetailBranch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#BB86FC"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="9dp"/>

                <TextView
                    android:id="@+id/tvDetailIssue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Issue: Power supply failure"
                    android:textColor="#888888"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/tvDetailDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Description: No description provided."
                    android:textColor="#AAAAAA"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#2A2A2A"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quoted Price"
                            android:textColor="#888888"
                            android:textSize="11sp"/>
                        <TextView
                            android:id="@+id/tvDetailPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$100"
                            android:textColor="#4CAF50"
                            android:textSize="18sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Payment Status"
                            android:textColor="#888888"
                            android:textSize="11sp"/>
                        <TextView
                            android:id="@+id/tvDetailPayment"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Unpaid"
                            android:textColor="#CF6679"
                            android:textSize="18sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- PRICE SETTING SECTION (Visible only for Pending Bookings) -->
        <LinearLayout
            android:id="@+id/layoutPriceSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SET REPAIR QUOTATION ($)"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etQuotationPrice"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#161618"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:textSize="16sp"
                android:inputType="numberDecimal"
                android:hint="Enter amount"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="16dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveQuotation"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Save &amp; Set Price"
                android:textColor="#000000"
                android:textStyle="bold"
                app:backgroundTint="#BB86FC"
                app:cornerRadius="12dp"/>
        </LinearLayout>

        <!-- CAMERA & GALLERY SECTION (Visible only for Approved / In Repair jobs) -->
        <LinearLayout
            android:id="@+id/layoutCameraSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REPAIR COMPLETION PHOTO"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCapturePhoto"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="📷 Capture Repair Photo"
                android:textColor="#BB86FC"
                app:strokeColor="#BB86FC"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickGallery"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="📁 Choose Photo from Gallery"
                android:textColor="#BB86FC"
                app:strokeColor="#BB86FC"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp"
                android:layout_marginBottom="12dp"/>

            <!-- Captured Photo Preview -->
            <ImageView
                android:id="@+id/ivCapturedPreview"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:background="#161618"
                android:visibility="gone"
                android:layout_marginBottom="16dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUploadAndReady"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Upload"
                android:textColor="#000000"
                android:textStyle="bold"
                app:backgroundTint="#4CAF50"
                app:cornerRadius="12dp"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- PAYMENT MANAGEMENT SECTION (Visible for Approved / Active jobs) -->
        <LinearLayout
            android:id="@+id/layoutPaymentSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PAYMENT MANAGEMENT"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTogglePayment"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Mark as Paid"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="#BB86FC"
                app:cornerRadius="12dp"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>