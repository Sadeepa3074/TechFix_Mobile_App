<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#09090B"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingTop="56dp"
        android:paddingBottom="24dp">

        <!-- Top Bar: Menu / Back & Logo -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardBackgroundColor="#161618"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#FFFFFF" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvTopTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Book a Repair"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintEnd_toStartOf="@id/btnProfile"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="@id/btnBack" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnProfile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#BB86FC"
            app:strokeWidth="1.5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/techfix_icon" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Section Header -->
        <TextView
            android:id="@+id/tvNewBooking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="NEW BOOKING"
            android:textColor="#888888"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnBack" />

        <TextView
            android:id="@+id/tvMainTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Book a Repair"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvNewBooking" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Auto-routed to your nearest available branch"
            android:textColor="#888888"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvMainTitle" />

        <!-- DEVICE TYPE CHIPS / GRID -->
        <TextView
            android:id="@+id/tvDeviceTypeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="DEVICE TYPE"
            android:textColor="#888888"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle" />

        <GridLayout
            android:id="@+id/gridDeviceTypes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDeviceTypeLabel">

            <!-- Device 1: Smartphone -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chipSmartphone"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#161618"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Smartphone"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Device 2: Laptop -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chipLaptop"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:layout_marginHorizontal="3dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#161618"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Laptop"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Device 3: Tablet -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chipTablet"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#161618"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Tablet"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Device 4: Desktop -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chipDesktop"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="#161618"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Desktop"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Device 5: Gaming Console -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chipConsole"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:layout_marginHorizontal="3dp"
                app:cardBackgroundColor="#161618"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="Gaming\nConsole"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Device 6: Other -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chipDeviceOther"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="#161618"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Other"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>

        <!-- ISSUE TYPE CHIPS / GRID -->
        <TextView
            android:id="@+id/tvIssueTypeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="ISSUE TYPE"
            android:textColor="#888888"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/gridDeviceTypes" />

        <GridLayout
            android:id="@+id/gridIssueTypes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvIssueTypeLabel">

            <!-- Issue 1: Screen Damage -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chipScreen"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#161618"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Screen Damage"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Issue 2: Battery Issue -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chipBattery"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#161618"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Battery Issue"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Issue 3: Water Damage -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chipWater"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#161618"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Water Damage"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Issue 4: Software Problem -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chipSoftware"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#161618"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Software Problem"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Issue 5: Charging Issue -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chipCharging"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#161618"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Charging Issue"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Issue 6: Speaker / Mic -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chipSpeaker"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#161618"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Speaker / Mic"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Issue 7: Camera Damage -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chipCamera"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="#161618"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Camera Damage"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Issue 8: Other Issue -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chipIssueOther"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="#161618"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Other"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>

        <!-- ADDITIONAL NOTES -->
        <TextView
            android:id="@+id/tvNotesLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="ADDITIONAL NOTES"
            android:textColor="#888888"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/gridIssueTypes" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNotes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#161618"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#333333"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvNotesLabel">

            <EditText
                android:id="@+id/etIssueDescription"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:background="@android:color/transparent"
                android:gravity="top|start"
                android:hint="Describe the issue in more detail..."
                android:inputType="textMultiLine"
                android:padding="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:textSize="14sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- AUTO-ROUTING ENABLED INFO BOX -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAutoRouting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#100D14"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#BB86FC"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardNotes">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <!-- Location Pin Indicator -->
                <ImageView
                    android:id="@+id/ivPin"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_mylocation"
                    app:tint="#BB86FC"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvAutoRoutingTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Auto-routing enabled"
                    android:textColor="#BB86FC"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivPin"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvAutoRoutingDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="2dp"
                    android:text="We'll find the nearest TechFix branch with availability for your device type."
                    android:textColor="#888888"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivPin"
                    app:layout_constraintTop_toBottomOf="@id/tvAutoRoutingTitle" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SUBMIT / CONTINUE BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitBooking"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:text="Select device &amp; issue to continue"
            android:textAllCaps="false"
            android:textColor="#777777"
            android:textSize="15sp"
            app:backgroundTint="#161618"
            app:cornerRadius="16dp"
            app:elevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardAutoRouting" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>