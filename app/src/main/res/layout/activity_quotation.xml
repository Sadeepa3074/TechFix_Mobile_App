<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TechFix Quotation Request"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/etCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Category (e.g., Laptop Screen, RAM)"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Item Details / Specifications"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Quantity Needed"
        android:inputType="number"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Location: Not Captured"
        android:textColor="#555555"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnGetLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fetch Current GPS Location"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnSubmitQuote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Submit Quotation Request" />

</LinearLayout>